/**
 * Thème Rofi — reprend la palette Gruvbox déjà utilisée dans waybar/style.css
 * (fond #1d2021, accent orange #fe8019, texte #ebdbb2) pour rester cohérent
 * visuellement avec la barre de statut.
 */

* {
	bg:             #1d2021;
	bg-alt:         #3c3836e6;
	fg:             #ebdbb2;
	fg-dim:         #928374;
	accent:         #fe8019;
	fg-selected:    #1d2021;
	border:         #665c54;

	background-color: transparent;
	text-color:        @fg;
}

window {
	location:       center;
	width:          32%;
	border-radius:  12px;
	background-color: @bg;
	border:         2px;
	border-color:   @accent;
	padding:        14px;
}

mainbox {
	background-color: transparent;
	children:       [ inputbar, listview ];
	spacing:        10px;
}

inputbar {
	background-color: @bg-alt;
	border-radius:  8px;
	padding:        10px 12px;
	spacing:        8px;
	children:       [ prompt, entry ];
}

prompt {
	text-color:     @accent;
	font:           "JetBrainsMono Nerd Font Bold 11";
}

entry {
	placeholder:       "Rechercher…";
	placeholder-color: @fg-dim;
	text-color:        @fg;
}

listview {
	lines:          8;
	columns:        1;
	spacing:        4px;
	background-color: transparent;
	scrollbar:      false;
	fixed-height:   false;
}

element {
	padding:        8px 10px;
	border-radius:  8px;
	background-color: transparent;
	text-color:     @fg;
}

element-icon {
	size:           22px;
	padding:        0 10px 0 0;
}

element-text {
	vertical-align: 0.5;
}

element selected {
	background-color: @accent;
	text-color:        @fg-selected;
}

element selected element-icon {
	text-color:     @fg-selected;
}

message {
	background-color: @bg-alt;
	border-radius:  8px;
	padding:        8px;
}

error-message {
	background-color: @bg;
	text-color:     #fb4934;
}
