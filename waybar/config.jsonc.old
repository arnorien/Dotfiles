{
  "layer": "top",
  "position": "top",
  "modules-left": ["custom/idle-inhibit", "clock", "custom/weather", "hyprland/window"],

  "modules-center": ["hyprland/workspaces"],

  "modules-right": [
    "pulseaudio",
    "custom/uptime",
    "backlight",
    "battery",
    "network",
    "cpu",
    "memory",
    "tray",
    "custom/power"
  ],

  "hyprland/workspaces": {
    "format": "{name} {icon}",
    "show-special": true,
    "format-icons": {
      "active": "󱓻",
      "default": "󱓼"
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  },

  "custom/music": {
    "format": "  {}",
    "escape": true,
    "interval": 5,
    "tooltip": false,
    "exec": "playerctl metadata --format='{{ artist }} - {{ title }}'",
    "on-click": "playerctl play-pause",
    "max-length": 50
  },

  "clock": {
    "timezone": "Europe/Paris",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%d/%m/%Y - %H:%M}",
    "interval": 1
  },

  "network": {
    "format-wifi": "{bandwidthDownBits} 󰤢 ",
    "format-ethernet": "{bandwidthDownBits} 󰈀" ,
    "format-disconnected": "No Network 󰖪 ",
    "interval": 5,
    "tooltip": false
  },


  "cpu": {
    "interval": 1,
    "format": "{icon0}{icon1}{icon2}{icon3} {usage:>2}%  ",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
  },

  "backlight" : {
    "format": "{percent}% {icon}",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
  },

 "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-full": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },

  // "battery" : {
  //   "interval": 30,
  //   "format": "{capacity}% {icon}",
  //   "format-icons": ["", "", "", "", ""],
  // },

  "memory": {
    "interval": 30,

    "format": "{used:0.1f}G/{total:0.1f}G  "
  },

  "custom/uptime": {
    "format": "{}",
    "interval": 60,
    "exec": "sh -c '(uptime -p)'"
  },

  "pulseaudio": {
    // "scroll-step": 1, // %, can be a float
    "format": "{volume}% {icon} {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": " {format_source}",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol",},
 
  //"pulseaudio": {
   // "format": "{volume}% {icon}",
    //"format-muted": "",
    //"format-icons": {
    //  "default": ["", "", " "]
    //},
    //"on-click": "pavucontrol"
   //},

  "custom/idle-inhibit": {
    "exec": "if [ -f $HOME/.cache/hypridle_inhibit.lock ]; then echo '{\"text\":\"\",\"class\":\"active\",\"tooltip\":\"Veille désactivée - cliquer pour réactiver\"}'; else echo '{\"text\":\"󰾪\",\"class\":\"inactive\",\"tooltip\":\"Veille activée - cliquer pour désactiver\"}'; fi",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "~/.config/hypr/scripts/toggle-idle-inhibit.sh",
    "tooltip": true
},

  "custom/power": {
    "tooltip": false,
    "on-click": "hyprlock",
    "format": "⏻"
  },

}
