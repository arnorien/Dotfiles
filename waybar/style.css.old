* {
  font-family: FontAwesome;
  font-size: 12px;
  min-height: 0;
  padding-right: 2px;
  padding-left: 2px;
  padding-bottom: 0px;
}

#waybar {
  background: transparent;
  color: #c6d0f5;
}

#workspaces {
  border-radius: 5px;
  margin: 5px;
  background: #101010;
}

#workspaces button {
  color: #8caaee;
  border-radius: 5px;
  padding: 0.4rem;
}

#workspaces button.active {
  border-radius: 5px;
  padding: 0.4rem;
}

button {
  background: transparent;
}

#custom-music,
#tray,
#backlight,
#clock,
#battery,
#pulseaudio,
#network,
#cpu,
#memory,
#custom-lock,
#custom-power,
#custom-weather,
#custom-uptime,
#custom-docker {
  background-color: #101010;
  padding: 0.5rem 1rem;
  margin: 5px 0;
}

#window {
  padding: 0.5rem 1rem;
  margin: 5px;
  color: #8caaee;
  font-family: FontAwesome;
  background-color: #101010;
  border-radius: 5px;
}

window#waybar.empty #window {
  background-color: transparent;
}

#clock {
  color: #8caaee;
  border-radius: 5px;
}

#custom-weather {
  color: #8caaee;
  margin-left: 0.5rem;
  border-radius: 5px;
}

#battery {
  color: #a6d189;
}

#battery.charging {
  color: #a6d189;
}

#battery.warning:not(.charging) {
  color: #e78284;
}

#battery.critical:not(.charging) {
  color: #e78284;
}

#backlight {
  color: #e5c890;
}

#backlight,
#battery {
  border-radius: 0;
}

#pulseaudio {
  color: #ea999c;
  border-radius: 5px 0px 0px 5px;
}

#custom-music {
  color: #ca9ee6;
  border-radius: 5px;
}

#custom-idle-inhibit {
  background-color: #101010;
  padding: 0.5rem 1rem;
  margin: 5px;
  margin-left: 0;
  border-radius: 5px;
}

#custom-idle-inhibit.active {
  color: #e78284;
}

#custom-idle-inhibit.inactive {
  color: #8caaee;
}

#custom-power {
  border-radius: 0px 5px 5px 0px;
  color: #e78284;
}

